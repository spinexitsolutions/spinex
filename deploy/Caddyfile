# Agency custom domains of Seller Kit (/opt/seller): Caddy asks the app before making a certificate.
{
	on_demand_tls {
		ask http://172.18.0.1:4100/api/public/domain-check
	}
}

# HTTPS certificates are made and renewed automatically.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# While a new version swaps in (a few seconds), visitors wait instead of seeing an error.
	reverse_proxy app:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# AgencyVault (/opt/agencyvault): its own Docker Compose stack, published on the spinex_default gateway.
www.agencyvault.tech {
	redir https://agencyvault.tech{uri} permanent
}

agencyvault.tech {
	encode zstd gzip
	reverse_proxy 172.18.0.1:4000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Seller Kit (/opt/seller): its own Docker Compose stack, published on the spinex_default gateway.
seller.spinexitsolutions.com {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy 172.18.0.1:4100 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Seller Kit agency white-label domains (only domains the app has verified get HTTPS).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy 172.18.0.1:4100 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
