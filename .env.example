# Tip: email, AI chatbot, spam protection and webhook keys can also be set in
# Admin → API keys (saved encrypted in the database). Values there win over this file.

# --- Public website address (used for SEO, sitemap and share links) ---
NEXT_PUBLIC_SITE_URL=https://spinexwebsolutions.in

# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spinex

# --- Admin login (/admin) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
# Any long random text (32+ characters). Keeps admin sessions secure.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Optional: real AI replies in the chatbot ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001

# --- Email alerts for new leads and applications (optional) ---
# Gmail: turn on 2-Step Verification, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-letter-app-password
# Where alerts are sent (can be the same Gmail)
NOTIFY_EMAIL=yourgmail@gmail.com

# --- Spam protection for forms (optional, free at dash.cloudflare.com > Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional; can also be set in Admin > WhatsApp and analytics) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
